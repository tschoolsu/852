# 網站
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_URL=http://localhost:3000
SESSION_SECRET=
TRUST_PROXY=0

# 帳號政策：instant（立即啟用）或 approval（管理員審核）
REGISTRATION_MODE=instant
ALLOWED_EMAIL_DOMAIN=tschool.tp.edu.tw
ADMIN_EMAILS=

# 資料位置；換電腦時可整個搬移此資料夾
DATA_DIR=./data
# 單次上傳的安全限制（預設 1 GiB）；這不限制帳號或系統總容量
MAX_UPLOAD_BYTES=1073741824

# 儲存：local 適合本機開發；上線後改成 s3，可連 Cloudflare R2、AWS S3 等
STORAGE_DRIVER=local
S3_REGION=auto
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# SMTP 寄信；本機開發可先留白，重設連結會顯示在執行視窗
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=T-Files 學生會檔案管理
SMTP_FROM_EMAIL=
