# Copy to .env.local; keep real values out of Git.
APP_URL=http://127.0.0.1:3005
DATABASE_URL=postgresql://t_files:replace-me@127.0.0.1:5432/t_files
FILE_STORAGE_PATH=./data/files
SESSION_SECRET=replace-with-at-least-32-random-bytes
ALLOWED_EMAIL_DOMAIN=tschool.tp.edu.tw
ADMIN_EMAILS=11430106@tschool.tp.edu.tw
REGISTRATION_MODE=instant
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM_EMAIL=replace-me@tschool.tp.edu.tw
SMTP_FROM_NAME=T-Files 學生會檔案管理系統
# Set to clamd in production after installing ClamAV.
FILE_SCAN_MODE=off
# Optional: database connection pool size (default 10)
DB_POOL_SIZE=10
