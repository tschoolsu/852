[Unit]
Description=T-Files PostgreSQL and private file backup

[Service]
Type=oneshot
User=service
Group=service
WorkingDirectory=/home/service/t-files/cloud
ExecStart=/usr/bin/bash /home/service/t-files/cloud/ops/backup-with-pm2.sh
TimeoutStartSec=20min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
