<%- include('partials/head', { title: '忘記密碼', bodyClass: 'auth-page' }) %>
<%- include('partials/nav') %>
<main class="single-card-shell">
  <section class="auth-panel narrow">
    <p class="eyebrow">帳號協助</p>
    <h1>忘記密碼</h1>
    <p>輸入學校電子郵件；若帳號存在，系統會寄出 30 分鐘內有效的重設連結。</p>
    <% if (notice) { %><div class="notice success" role="status"><%= notice %></div><% } %>
    <% if (error) { %><div class="notice error" role="alert"><%= error %></div><% } %>
    <form method="post" action="/forgot-password" class="stack-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>學校電子郵件
        <input type="email" name="email" autocomplete="email" placeholder="name@<%= allowedEmailDomain %>" required autofocus>
      </label>
      <button class="primary-button full" type="submit">寄出重設說明</button>
    </form>
    <a class="back-link" href="/login">返回登入</a>
  </section>
</main>
<%- include('partials/footer') %>
