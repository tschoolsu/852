<%- include('partials/head', { title: '登入', bodyClass: 'auth-page' }) %>
<%- include('partials/nav') %>
<main class="auth-shell">
  <section class="auth-intro login-intro">
    <h1>學生會檔案管理系統</h1>
    <p>使用學校 Google 帳號登入。</p>
  </section>
  <section class="auth-panel" aria-labelledby="login-title">
    <p class="eyebrow">歡迎回來</p>
    <h2 id="login-title">登入</h2>
    <% if (notice) { %><div class="notice success" role="status"><%= notice %></div><% } %>
    <% if (error) { %><div class="notice error" role="alert"><%= error %></div><% } %>
    <p class="subtle">第一次登入會自動建立帳號，並從 Google 同步學校信箱與本名。系統不會取得或保存你的 Google 密碼。</p>
    <% if (googleReady) { %>
      <a class="primary-button full google-signin" href="/auth/google?next=<%= encodeURIComponent(nextPath) %>">使用學校 Google 帳號登入</a>
    <% } else { %>
      <button class="primary-button full" type="button" disabled>Google 登入尚未設定</button>
    <% } %>
    <p class="auth-switch">僅接受 @<%= allowedEmailDomain %> 的學校帳號</p>
  </section>
</main>
<%- include('partials/footer') %>
