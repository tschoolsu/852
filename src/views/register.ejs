<%- include('partials/head', { title: '註冊', bodyClass: 'auth-page' }) %>
<%- include('partials/nav') %>
<main class="auth-shell compact">
  <section class="auth-intro">
    <span class="status-chip">建立識別</span>
    <h1>加入學生會的<br>共同工作空間。</h1>
    <p>目前註冊後即可開始使用。</p>
  </section>
  <section class="auth-panel" aria-labelledby="register-title">
    <p class="eyebrow">@<%= allowedEmailDomain %></p>
    <h2 id="register-title">建立帳號</h2>
    <% if (error) { %><div class="notice error" role="alert"><%= error %></div><% } %>
    <% if (notice) { %><div class="notice" role="status"><%= notice %></div><% } %>
    <p class="registration-copy">請先登入學校的 Google 帳號。系統會讀取已驗證的學校信箱與本名，並自動把本名設為顯示名稱。</p>
    <% if (googleReady) { %>
      <a class="google-button" href="/auth/google/register"><span aria-hidden="true">G</span>使用學校 Google 帳號驗證</a>
    <% } else { %>
      <span class="google-button disabled" aria-disabled="true"><span aria-hidden="true">G</span>學校 Google 驗證尚未設定</span>
      <p class="setup-note">管理員完成 Google OAuth 設定後即可註冊。</p>
    <% } %>
    <p class="privacy-note">只讀取姓名與學校信箱，不會取得 Google 密碼、雲端硬碟或其他資料。</p>
    <p class="auth-switch">已經有帳號？<a href="/login">返回登入</a></p>
  </section>
</main>
<%- include('partials/footer') %>
