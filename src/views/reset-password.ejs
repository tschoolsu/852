<%- include('partials/head', { title: '重設密碼', bodyClass: 'auth-page' }) %>
<%- include('partials/nav') %>
<main class="single-card-shell">
  <section class="auth-panel narrow">
    <p class="eyebrow">帳號協助</p>
    <h1>設定新密碼</h1>
    <% if (error) { %><div class="notice error" role="alert"><%= error %></div><% } %>
    <form method="post" action="/reset-password/<%= token %>" class="stack-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>新密碼 <span class="label-note">至少 15 個字元</span>
        <input type="password" name="password" autocomplete="new-password" minlength="15" maxlength="128" required autofocus>
      </label>
      <label>再次輸入新密碼
        <input type="password" name="passwordConfirm" autocomplete="new-password" minlength="15" maxlength="128" required>
      </label>
      <button class="primary-button full" type="submit">更新密碼</button>
    </form>
  </section>
</main>
<%- include('partials/footer') %>
