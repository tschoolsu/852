generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String @id
  email         String @unique
  displayName   String @map("display_name")
  googleSubject String @unique @map("google_subject")
  role          String @default("member")
  status        String @default("active")
  createdAt     String @map("created_at")
  updatedAt     String @map("updated_at")

  @@map("users")
}

model Session {
  tokenHash String @id @map("token_hash")
  userId    String @map("user_id")
  csrfToken String @map("csrf_token")
  expiresAt String @map("expires_at")
  createdAt String @map("created_at")

  @@index([userId], map: "idx_sessions_user")
  @@index([expiresAt], map: "idx_sessions_expires")
  @@map("sessions")
}

model OauthState {
  stateHash    String @id @map("state_hash")
  codeVerifier String @map("code_verifier")
  nonce        String
  nextPath     String @default("/") @map("next_path")
  expiresAt    String @map("expires_at")
  createdAt    String @map("created_at")

  @@index([expiresAt], map: "idx_oauth_states_expires")
  @@map("oauth_states")
}

model Resource {
  id           String @id
  kind         String
  title        String
  description  String @default("")
  url          String?
  storageKey   String? @map("storage_key")
  originalName String? @map("original_name")
  mimeType     String? @map("mime_type")
  sizeBytes    BigInt? @map("size_bytes")
  ownerId      String @map("owner_id")
  parentId     String? @map("parent_id")
  accessLevel  String @default("private") @map("access_level")
  revision     Int @default(1)
  trashedAt    String? @map("trashed_at")
  createdAt    String @map("created_at")
  updatedAt    String @map("updated_at")

  @@index([parentId], map: "idx_resources_parent")
  @@index([ownerId], map: "idx_resources_owner")
  @@index([trashedAt], map: "idx_resources_trash")
  @@map("resources")
}

model ResourceMember {
  resourceId String @map("resource_id")
  userId     String @map("user_id")
  role       String

  @@id([resourceId, userId])
  @@index([userId], map: "idx_resource_members_user")
  @@map("resource_members")
}

model ShareLink {
  resourceId String @id @map("resource_id")
  tokenHash  String @unique @map("token_hash")
  role       String
  createdAt  String @map("created_at")

  @@map("share_links")
}

model ResourceVersion {
  resourceId   String @map("resource_id")
  revision     Int
  kind         String
  title        String
  description  String
  url          String?
  storageKey   String? @map("storage_key")
  originalName String? @map("original_name")
  mimeType     String? @map("mime_type")
  sizeBytes    BigInt? @map("size_bytes")
  parentId     String? @map("parent_id")
  event        String
  actorId      String @map("actor_id")
  createdAt    String @map("created_at")

  @@id([resourceId, revision])
  @@index([resourceId, createdAt], map: "idx_resource_versions_created")
  @@map("resource_versions")
}

model AuditLog {
  id        BigInt @id @default(autoincrement())
  actorId   String? @map("actor_id")
  action    String
  targetId  String? @map("target_id")
  details   String @default("{}")
  createdAt String @map("created_at")

  @@index([createdAt], map: "idx_audit_log_created")
  @@map("audit_log")
}

model PasswordCredential {
  userId       String @id @map("user_id")
  passwordHash String @map("password_hash")
  verifiedAt   String @map("verified_at")
  changedAt    String @map("changed_at")

  @@map("password_credentials")
}

model AuthToken {
  tokenHash String @id @map("token_hash")
  email     String
  purpose   String
  expiresAt String @map("expires_at")
  createdAt String @map("created_at")

  @@index([email], map: "idx_auth_tokens_email")
  @@index([expiresAt], map: "idx_auth_tokens_expires")
  @@map("auth_tokens")
}

model AuthRateLimit {
  key       String @id
  hits      Int
  expiresAt BigInt @map("expires_at")

  @@index([expiresAt], map: "idx_auth_rate_expires")
  @@map("auth_rate_limits")
}
